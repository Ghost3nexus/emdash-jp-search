{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "jp-search",
	"publisher": "did:plc:at3h3l2dw7hrh4maaj3ysx6r",

	"license": "MIT",
	"author": { "name": "TomorrowProof" },
	"security": { "email": "kozuki@tomorrowproof-ai.com" },
	"description": "Nodeプラットフォームなど FTS5 が使えない環境向けの日本語サイト内検索。Nグラム索引で部分一致でき、blocks 本文も対象にできる。Cloudflare Workers なら公式の AI Search プラグインが先。",

	// Trust contract. Reads published content to build its own index;
	// reads collection definitions so it needs no per-site configuration.
	// It never writes content, sends mail, or talks to the network.
	"capabilities": ["content:read", "schema:read"],
	"allowedHosts": [],

	// Block Kit admin surface. Both of these are rendered by the single `admin`
	// route, which is where the host dispatches every page, widget and button.
	// The labels cannot follow the admin locale — the manifest is static — so
	// they stay Japanese like the description; the screen itself reads
	// `routeCtx.ui.locale` and answers in Japanese or English.
	"admin": {
		"pages": [{ "path": "/jp-search", "label": "日本語検索", "icon": "search" }],
		"widgets": [{ "id": "index-health", "title": "日本語検索の索引", "size": "third" }]
	},

	"storage": {
		// One record per indexed entry.
		"docs": {
			"indexes": ["collection", "locale", "updatedAt", ["collection", "locale"]]
		},
		// Inverted index: one record per (token, doc) pair.
		"postings": {
			"indexes": ["token", "docId", ["token", "docId"]]
		}
	}
}
